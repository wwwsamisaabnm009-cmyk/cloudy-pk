
{
  "expo": {
    "name": "restaurant",
    "slug": "restaurant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/export logo.png",
    "scheme": "restaurant",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/export logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/export logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.malikanaseer.restaurant"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/export logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/export logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "79435f72-c1d6-410e-be8a-7f0133e17338"
      }
    }
  }
}